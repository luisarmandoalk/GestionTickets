# Copie este archivo como .env y ajuste los valores. El archivo .env no se sube al repositorio.
# La aplicación lo lee al iniciar (spring.config.import) y Docker Compose lo usa para sus variables.

# --- Base de datos PostgreSQL ---
DB_URL=jdbc:postgresql://localhost:5432/tickets_db
DB_USERNAME=postgres
DB_PASSWORD=postgres

# --- Inteligencia artificial ---
# AI_MODE: auto   -> usa el modelo de lenguaje si hay AI_API_KEY; si no, el clasificador por reglas
#          llm    -> siempre el modelo de lenguaje (por ejemplo, Ollama local sin API key)
#          reglas -> siempre el clasificador por reglas, sin llamadas externas
AI_MODE=auto

# Cualquier proveedor con API compatible con OpenAI (/chat/completions):
#   Groq:       https://api.groq.com/openai/v1
#   OpenRouter: https://openrouter.ai/api/v1
#   OpenAI:     https://api.openai.com/v1
#   Ollama:     http://localhost:11434/v1   (con AI_MODE=llm y sin API key)
AI_BASE_URL=https://api.groq.com/openai/v1
# Con AI_MODE=auto, si se deja vacía se usa el clasificador por reglas.
AI_API_KEY=
AI_MODEL=llama-3.3-70b-versatile

# Si el modelo falla (caído, timeout o respuesta inválida): true = clasificar con reglas, false = responder 503/502
AI_FALLBACK=true
AI_TIMEOUT=15s
AI_RETRIES=1
